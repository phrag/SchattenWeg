{
  "version": 8,
  "name": "Schattenweg Dark",
  "glyphs": "__GLYPHS_URL__",
  "sources": {
    "omt": {
      "type": "vector",
      "url": "pmtiles://__PMTILES_URL__"
    }
  },
  "layers": [
    { "id": "background", "type": "background",
      "paint": { "background-color": "#171c26" } },

    { "id": "landcover", "type": "fill", "source": "omt", "source-layer": "landcover",
      "paint": { "fill-color": "#1b2a1e", "fill-opacity": 0.6 } },

    { "id": "landuse-residential", "type": "fill", "source": "omt", "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": { "fill-color": "#1d2330", "fill-opacity": 0.5 } },

    { "id": "park", "type": "fill", "source": "omt", "source-layer": "park",
      "paint": { "fill-color": "#1e3124", "fill-opacity": 0.85 } },

    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water",
      "paint": { "fill-color": "#20384f" } },

    { "id": "waterway", "type": "line", "source": "omt", "source-layer": "waterway",
      "paint": { "line-color": "#20384f", "line-width": 1.4 } },

    { "id": "building", "type": "fill", "source": "omt", "source-layer": "building",
      "minzoom": 12,
      "paint": { "fill-color": "#262d38", "fill-outline-color": "#333c49" } },

    { "id": "rail", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "paint": { "line-color": "#3a4453", "line-width": { "stops": [[11, 0.6], [16, 1.5]] } } },

    { "id": "road-path", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", "class", "path", "track"], "minzoom": 14,
      "paint": { "line-color": "#3a4453", "line-width": 1,
                 "line-dasharray": [2, 1.5] } },

    { "id": "road-minor", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"],
      "paint": { "line-color": "#48566a",
                 "line-width": { "stops": [[12, 0.4], [14, 1.2], [18, 6]] } } },

    { "id": "road-major", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary"],
      "paint": { "line-color": "#6b7a90",
                 "line-width": { "stops": [[8, 0.8], [11, 1.8], [14, 3.5], [18, 12]] } } },

    { "id": "boundary", "type": "line", "source": "omt", "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": { "line-color": "#4a5060", "line-dasharray": [2, 2], "line-width": 1 } },

    { "id": "label-street", "type": "symbol", "source": "omt",
      "source-layer": "transportation_name", "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#c2cad6",
        "text-halo-color": "#171c26",
        "text-halo-width": 1.6
      } },

    { "id": "label-transit", "type": "symbol", "source": "omt",
      "source-layer": "transportation_name", "minzoom": 14,
      "filter": ["==", "class", "rail"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-anchor": "top",
        "text-offset": [0, 0.6]
      },
      "paint": {
        "text-color": "#8fa6c8",
        "text-halo-color": "#171c26",
        "text-halo-width": 1.6
      } },

    { "id": "label-place", "type": "symbol", "source": "omt",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town", "suburb", "quarter", "neighbourhood"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": { "stops": [[10, 12], [14, 16]] },
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#dbe2ea",
        "text-halo-color": "#171c26",
        "text-halo-width": 1.8
      } }
  ]
}
