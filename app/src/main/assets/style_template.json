{
  "version": 8,
  "name": "Schattenweg Dark",
  "sources": {
    "omt": {
      "type": "vector",
      "url": "pmtiles://__PMTILES_URL__"
    }
  },
  "layers": [
    { "id": "background", "type": "background",
      "paint": { "background-color": "#10141a" } },

    { "id": "landcover", "type": "fill", "source": "omt", "source-layer": "landcover",
      "paint": { "fill-color": "#141c16", "fill-opacity": 0.55 } },

    { "id": "park", "type": "fill", "source": "omt", "source-layer": "park",
      "paint": { "fill-color": "#152019", "fill-opacity": 0.8 } },

    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water",
      "paint": { "fill-color": "#182634" } },

    { "id": "waterway", "type": "line", "source": "omt", "source-layer": "waterway",
      "paint": { "line-color": "#182634", "line-width": 1.2 } },

    { "id": "building", "type": "fill", "source": "omt", "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#1a1f26", "fill-outline-color": "#232a33" } },

    { "id": "rail", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "paint": { "line-color": "#262d36", "line-width": 1 } },

    { "id": "road-path", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", "class", "path", "track"],
      "paint": { "line-color": "#242b33", "line-width": 1,
                 "line-dasharray": [2, 1.5] } },

    { "id": "road-minor", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"],
      "paint": { "line-color": "#2a323c",
                 "line-width": { "stops": [[13, 0.7], [18, 5]] } } },

    { "id": "road-major", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary"],
      "paint": { "line-color": "#39434f",
                 "line-width": { "stops": [[10, 1], [18, 10]] } } },

    { "id": "boundary", "type": "line", "source": "omt", "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": { "line-color": "#3a3f4a", "line-dasharray": [2, 2] } }
  ]
}
